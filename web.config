<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Evolution API - Port 2345 -->
        <rule name="Evolution API" stopProcessing="true">
          <match url="^evolution/(.*)" />
          <action type="Rewrite" url="http://localhost:2345/{R:1}" />
        </rule>

        <!-- Backend API - Port 55453 -->
        <rule name="Backend API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:55453/api/{R:1}" />
        </rule>

        <!-- Manager Frontend - Port 4567 -->
        <rule name="Manager Frontend" stopProcessing="true">
          <match url="^(.*)" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/evolution/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:4567/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- WebSocket Support -->
    <webSocket enabled="true" />

    <!-- Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-API-Token, X-Device-UUID" />
      </customHeaders>
    </httpProtocol>

    <!-- Request Limits -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
